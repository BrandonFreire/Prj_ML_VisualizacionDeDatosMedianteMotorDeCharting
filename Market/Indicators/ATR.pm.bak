package Market::Indicators::ATR;

use strict;
use warnings;
use AI::MXNet qw(mx);


sub new {
    my ($class, $period) = @_;
    $period //= 14;
    my $self = {
        period      => $period,
        values      => [],
        _nd_atr     => undef,
        _prev_close => undef,
        _prev_atr   => undef,
        _tr_sum     => 0,
        _tr_count   => 0,
    };
    bless $self, $class;
    return $self;
}

sub compute_all {
    my ($self, $market_data) = @_;
    $self->reset();

    my $arr = $market_data->_active_array();
    my $n   = scalar @$arr;
    my $p   = $self->{period};
    return unless $n >= $p;

    my (@highs, @lows, @closes);
    for my $c (@$arr) {
        push @highs,  $c->{high};
        push @lows,   $c->{low};
        push @closes, $c->{close};
    }

    my $nd_h = mx->nd->array(\@highs,  ctx => mx->cpu());
    my $nd_l = mx->nd->array(\@lows,   ctx => mx->cpu());
    my $nd_c = mx->nd->array(\@closes, ctx => mx->cpu());

    my $cur_h  = $nd_h->slice([1, $n - 1]);
    my $cur_l  = $nd_l->slice([1, $n - 1]);
    my $prev_c = $nd_c->slice([0, $n - 2]);

    my $nd_tr_tail = ($cur_h - $cur_l)
                        ->maximum( ($cur_h - $prev_c)->abs() )
                        ->maximum( ($cur_l - $prev_c)->abs() );

    my @tr = ($highs[0] - $lows[0], $nd_tr_tail->asnumpy->list);
    my $nd_tr = mx->nd->array(\@tr, ctx => mx->cpu());

    my $nd_tr_warmup  = $nd_tr->slice([0, $p - 1]);
    my $nd_cum_warmup = $nd_tr_warmup->cumsum();
    my $nd_divisors   = mx->nd->array([1 .. $p], ctx => mx->cpu());
    my $nd_warmup_atr = $nd_cum_warmup / $nd_divisors;

    my @warmup_atrs = @{ $nd_warmup_atr->asarray() };
    my $seed        = $warmup_atrs[-1];

    my $m     = $n - $p;
    my $alpha = 1.0 / $p;
    my $beta  = ($p - 1.0) / $p;
    my $W     = 500;

    my @all_atrs = @warmup_atrs;

    my $offset = 0;
    while ($offset < $m) {
        my $w   = ($offset + $W <= $m) ? $W : $m - $offset;
        my $s   = $p + $offset;
        my $e   = $s + $w - 1;

        my $nd_tr_chunk = $nd_tr->slice([$s, $e]);

        my $nd_j  = mx->nd->array([0 .. $w - 1], ctx => mx->cpu());
        my $nd_bp = ($nd_j * log($beta))->exp();

        my $nd_s      = $nd_tr_chunk / $nd_bp;
        my $nd_cumsum = $nd_s->cumsum();

        my $nd_chunk = $nd_cumsum * $nd_bp * $alpha
                       + $nd_bp * ($seed * $beta);

        my @chunk_vals = @{ $nd_chunk->asarray() };
        push @all_atrs, @chunk_vals;
        $seed   = $chunk_vals[-1];
        $offset += $w;
    }

    $self->{values}  = \@all_atrs;
    $self->{_nd_atr} = mx->nd->array(\@all_atrs, ctx => mx->cpu());
}

sub update_last {
    my ($self, $market_data) = @_;
    my $candle = $market_data->last_candle();
    return unless $candle;

    my $tr = _true_range($candle, $self->{_prev_close});
    $self->{_prev_close} = $candle->{close};

    my $p   = $self->{period};
    my $atr;
    if (!defined $self->{_prev_atr}) {
        $self->{_tr_sum}   += $tr;
        $self->{_tr_count} += 1;
        $atr = $self->{_tr_sum} / $self->{_tr_count};
        $self->{_prev_atr} = $atr if $self->{_tr_count} >= $p;
    }
    else {
        $atr = (($p - 1) * $self->{_prev_atr} + $tr) / $p;
        $self->{_prev_atr} = $atr;
    }
    push @{ $self->{values} }, $atr;
}

sub get_values   { $_[0]->{values}   }
sub get_ndarray  { $_[0]->{_nd_atr}  }

sub reset {
    my ($self) = @_;
    $self->{values}      = [];
    $self->{_nd_atr}     = undef;
    $self->{_prev_close} = undef;
    $self->{_prev_atr}   = undef;
    $self->{_tr_sum}     = 0;
    $self->{_tr_count}   = 0;
}

sub _true_range {
    my ($candle, $prev_close) = @_;
    my $hl = $candle->{high} - $candle->{low};
    return $hl unless defined $prev_close;
    my $hpc = abs($candle->{high} - $prev_close);
    my $lpc = abs($candle->{low}  - $prev_close);
    my $tr  = $hl;
    $tr = $hpc if $hpc > $tr;
    $tr = $lpc if $lpc > $tr;
    return $tr;
}

1;
